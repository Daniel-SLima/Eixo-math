{
  "name": "eixo-math-workspace",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter eixo dev",
    "build": "pnpm --filter eixo build",
    "lint": "pnpm --filter @eixo/math-core lint && pnpm --filter eixo lint",
    "test": "pnpm --filter @eixo/math-core test && pnpm --filter eixo test",
    "e2e": "pnpm --filter eixo e2e",
    "typecheck": "pnpm --filter @eixo/math-core typecheck && pnpm --filter eixo typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e"
  }
}
